@model EucSaaS.Web.ViewModels.DashboardLayoutItems.DashboardLayoutItemEditViewModel

@{
    ViewData["Title"] = "Remove Dashboard Widget";
}

<div class="container-fluid py-4 dashboard-layout-item-delete-page">

    @* =========================================================
       Header
       ========================================================= *@

    <div class="d-flex
                flex-column
                flex-lg-row
                justify-content-between
                align-items-lg-start
                gap-3
                mb-4">

        <div>

            <h1 class="h3 mb-2">

                <i class="bi bi-trash me-2"></i>
                Remove Dashboard Widget

            </h1>

            <div class="text-muted">
                Confirm removal of this widget from the
                dashboard layout.
            </div>

        </div>

        <a asp-action="Index"
           asp-route-dashboardLayoutId="@Model.DashboardLayoutId"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Items

        </a>

    </div>

    @* =========================================================
       Warning
       ========================================================= *@

    <div class="alert
                alert-warning
                shadow-sm"
         role="alert">

        <div class="d-flex
                    align-items-start
                    gap-3">

            <i class="bi
                      bi-exclamation-triangle
                      fs-4">
            </i>

            <div>

                <div class="fw-semibold mb-1">
                    Remove widget from this layout?
                </div>

                <div>
                    This removes only the layout assignment.
                    The underlying dashboard widget definition
                    will not be deleted.
                </div>

            </div>

        </div>

    </div>

    @* =========================================================
       Widget assignment
       ========================================================= *@

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-header
                    bg-body-tertiary
                    py-3">

            <h2 class="h6 mb-1">

                <i class="bi bi-columns-gap me-1"></i>
                Widget Assignment

            </h2>

            <div class="small text-muted">
                Review the item before removing it.
            </div>

        </div>

        <div class="card-body">

            <div class="row g-4">

                @* -------------------------------------------------
                   Dashboard layout
                   ------------------------------------------------- *@

                <div class="col-12 col-md-6">

                    <div class="detail-panel h-100">

                        <div class="detail-label">
                            Dashboard Layout
                        </div>

                        <div class="fw-semibold">
                            @Model.LayoutName
                        </div>

                        <code class="text-body small">
                            @Model.LayoutCode
                        </code>

                    </div>

                </div>

                @* -------------------------------------------------
                   Dashboard widget
                   ------------------------------------------------- *@

                <div class="col-12 col-md-6">

                    <div class="detail-panel h-100">

                        <div class="detail-label">
                            Dashboard Widget
                        </div>

                        <div class="fw-semibold">
                            @Model.WidgetName
                        </div>

                        <div class="d-flex
                                    flex-wrap
                                    gap-2
                                    align-items-center
                                    mt-1">

                            <code class="text-body small">
                                @Model.WidgetCode
                            </code>

    <span class="badge dashboard-widget-type">

    @Model.WidgetType

</span>


                        </div>

                    </div>

                </div>

                @* -------------------------------------------------
                   Position
                   ------------------------------------------------- *@

                <div class="col-12 col-sm-6 col-lg-3">

                    <div class="detail-panel h-100">

                        <div class="detail-label">
                            Position
                        </div>

                        <div>
                            Row @Model.GridRow
                        </div>

                        <div>
                            Column @Model.GridColumn
                        </div>

                    </div>

                </div>

                @* -------------------------------------------------
                   Size
                   ------------------------------------------------- *@

                <div class="col-12 col-sm-6 col-lg-3">

                    <div class="detail-panel h-100">

                        <div class="detail-label">
                            Size
                        </div>

                        <div class="fw-semibold">
                            @Model.GridWidth × @Model.GridHeight
                        </div>

                    </div>

                </div>

                @* -------------------------------------------------
                   Display order
                   ------------------------------------------------- *@

                <div class="col-12 col-sm-6 col-lg-3">

                    <div class="detail-panel h-100">

                        <div class="detail-label">
                            Display Order
                        </div>

                        <div class="fw-semibold">
                            @Model.DisplayOrder
                        </div>

                    </div>

                </div>

                @* -------------------------------------------------
                   Visibility - fixed
                   ------------------------------------------------- *@

                <div class="col-12 col-sm-6 col-lg-3">

                    <div class="detail-panel h-100">

                        <div class="detail-label">
                            Visibility
                        </div>

   @if (Model.IsVisible)
{
    <span class="badge dashboard-visible-badge">

        <i class="bi bi-eye me-1"></i>
        Visible

    </span>
}
else
{
    <span class="badge dashboard-hidden-badge">

        <i class="bi bi-eye-slash me-1"></i>
        Hidden

    </span>
}


                    </div>

                </div>

            </div>

        </div>

    </div>

    @* =========================================================
       Settings JSON
       ========================================================= *@

    @if (!string.IsNullOrWhiteSpace(
        Model.SettingsJson))
    {
        <div class="card shadow-sm border-0 mb-4">

            <div class="card-header
                        bg-body-tertiary
                        py-3">

                <h2 class="h6 mb-0">

                    <i class="bi bi-braces me-1"></i>
                    Settings JSON

                </h2>

            </div>

            <div class="card-body">

                <pre class="settings-json mb-0">@Model.SettingsJson</pre>

            </div>

        </div>
    }

    @* =========================================================
       Delete form
       ========================================================= *@

    <form asp-action="Delete"
          asp-route-dashboardLayoutId="@Model.DashboardLayoutId"
          asp-route-id="@Model.Id"
          method="post">

        @Html.AntiForgeryToken()

        <input asp-for="Id"
               type="hidden" />

        <input asp-for="DashboardLayoutId"
               type="hidden" />

        <div class="d-flex
                    flex-column
                    flex-sm-row
                    justify-content-between
                    gap-2">

            <a asp-action="Index"
               asp-route-dashboardLayoutId="@Model.DashboardLayoutId"
               class="btn btn-outline-secondary">

                <i class="bi bi-x-circle me-1"></i>
                Cancel

            </a>

            <button type="submit"
                    class="btn btn-danger">

                <i class="bi bi-trash me-1"></i>
                Remove Widget

            </button>

        </div>

    </form>

</div>

<style>
    .dashboard-layout-item-delete-page {
        max-width: 1200px;
    }

    .detail-panel {
        padding: 1rem;
        border: 1px solid var(--bs-border-color);
        border-radius: var(--bs-border-radius);
        background-color: var(--bs-tertiary-bg);
    }

    .detail-label {
        margin-bottom: .5rem;
        color: var(--bs-secondary-color);
        font-size: .75rem;
        font-weight: 600;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .settings-json {
        padding: 1rem;
        overflow-x: auto;
        border: 1px solid var(--bs-border-color);
        border-radius: var(--bs-border-radius);
        background-color: var(--bs-tertiary-bg);
        white-space: pre-wrap;
        word-break: break-word;
    }

.dashboard-visible-badge {
    background-color: #198754;
    color: #ffffff;
    border: 1px solid #198754;
}

.dashboard-hidden-badge {
    background-color: #6c757d;
    color: #ffffff;
    border: 1px solid #6c757d;
}

</style>
