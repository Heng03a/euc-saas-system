@model EucSaaS.Web.ViewModels.Dashboard.DashboardViewModel

@if (Model.Widgets == null ||
     Model.Widgets.Count == 0)
{
    <div class="alert alert-info">
        <i class="bi bi-info-circle me-2"></i>

        No dashboard widgets are available for your role.
    </div>
}
else
{
    <div class="row g-4 dashboard-widget-grid">

        @foreach (var widget in Model.Widgets
            .OrderBy(x => x.RowPosition)
            .ThenBy(x => x.ColumnPosition)
            .ThenBy(x => x.DisplayOrder))
        {
            <partial name="_DashboardWidget"
                     model="widget" />
        }

    </div>
}
