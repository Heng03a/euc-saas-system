@model EucSaaS.Web.ViewModels.Dashboard.DashboardWidgetViewModel
@using System.Text.Json

@{
    var widget = Model;

    var width = widget.WidgetWidth <= 0
        ? 4
        : widget.WidgetWidth;

    var height = widget.Height <= 0
        ? 260
        : widget.Height;

    var color = string.IsNullOrWhiteSpace(widget.Color)
        ? "primary"
        : widget.Color;

    var icon = widget.Icon ?? string.Empty;

    var widgetType = widget.WidgetType ?? string.Empty;
}

@if (widgetType.Equals(
        "Card",
        StringComparison.OrdinalIgnoreCase))
{
    <div id="dashboardWidget_@widget.Id"
         class="col-md-@width dashboard-widget-container"
         data-widget-id="@widget.Id">

        <div class="card dashboard-card shadow-sm border-0 border-top border-4 border-@color h-100">

            <div class="card-body py-4"
                 style="min-height:@(height)px;">

                <div class="d-flex justify-content-between align-items-center gap-3 h-100">

                    <div>
                        <div class="text-muted fw-semibold">
                            @widget.WidgetTitle
                        </div>

                        <div class="fs-2 fw-bold text-@color">
                            @widget.Value
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-3">

                        @if (!string.IsNullOrWhiteSpace(icon))
                        {
                            <div class="display-4 text-@color opacity-25">
                                <i class="@icon"></i>
                            </div>
                        }

                        <button type="button"
                                class="btn btn-sm btn-outline-secondary refresh-widget-button"
                                data-widget-id="@widget.Id"
                                title="Refresh widget">

                            <i class="bi bi-arrow-clockwise"></i>

                        </button>

                    </div>

                </div>

            </div>

        </div>

    </div>
}
else if (widgetType.Equals(
             "Table",
             StringComparison.OrdinalIgnoreCase))
{
    <div id="dashboardWidget_@widget.Id"
         class="col-md-@width dashboard-widget-container"
         data-widget-id="@widget.Id">

        <div class="card dashboard-card shadow-sm border-0 h-100">

            <div class="card-header bg-@color text-white fw-bold d-flex justify-content-between align-items-center">

                <div>
                    @if (!string.IsNullOrWhiteSpace(icon))
                    {
                        <i class="@icon me-2"></i>
                    }

                    @widget.WidgetTitle
                </div>

                <button type="button"
                        class="btn btn-sm btn-light refresh-widget-button"
                        data-widget-id="@widget.Id"
                        title="Refresh widget">

                    <i class="bi bi-arrow-clockwise"></i>

                </button>

            </div>

            <div class="card-body"
                 style="height:@(height)px; overflow:auto;">

                @if (widget.Columns == null ||
                     !widget.Columns.Any())
                {
                    <div class="text-muted">
                        No columns returned.
                    </div>
                }
                else if (widget.Rows == null ||
                         !widget.Rows.Any())
                {
                    <div class="text-muted">
                        No data found.
                    </div>
                }
                else
                {
                    <div class="table-responsive">

                        <table class="table table-striped table-hover table-sm align-middle mb-0">

                            <thead class="table-light">
                                <tr>
                                    @foreach (var column in widget.Columns)
                                    {
                                        <th>@column</th>
                                    }
                                </tr>
                            </thead>

                            <tbody>

                                @foreach (var row in widget.Rows)
                                {
                                    <tr>

                                        @foreach (var column in widget.Columns)
                                        {
                                            var value = row.ContainsKey(column)
                                                ? row[column]
                                                : string.Empty;

                                            var isNumber = decimal.TryParse(
                                                value,
                                                out _);

                                            <td class="@(isNumber ? "text-end" : string.Empty)">
                                                @value
                                            </td>
                                        }

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>
                }

            </div>

        </div>

    </div>
}
else if (
    widgetType.Equals(
        "Bar",
        StringComparison.OrdinalIgnoreCase) ||
    widgetType.Equals(
        "Pie",
        StringComparison.OrdinalIgnoreCase) ||
    widgetType.Equals(
        "Chart",
        StringComparison.OrdinalIgnoreCase) ||
    widgetType.Equals(
        "Line",
        StringComparison.OrdinalIgnoreCase) ||
    widgetType.Equals(
        "Doughnut",
        StringComparison.OrdinalIgnoreCase))
{
    var chartId =
        $"chart_{widget.Id:N}";

    var chartData =
        widget.ChartData;

    var chartType =
        chartData?.ChartType ?? "bar";

    var labels =
        chartData?.Labels ??
        Array.Empty<string>();

    var values =
        chartData?.Values ??
        Array.Empty<decimal>();

    var showLegend =
        chartData?.ShowLegend ?? true;

    var hasChartData =
        chartData != null &&
        chartData.HasData &&
        labels.Count > 0 &&
        values.Count > 0;

    <div id="dashboardWidget_@widget.Id"
         class="col-md-@width dashboard-widget-container"
         data-widget-id="@widget.Id">

        <div class="card dashboard-card shadow-sm border-0 h-100">

            <div class="card-header bg-@color text-white fw-bold d-flex justify-content-between align-items-center">

                <div>
                    @if (!string.IsNullOrWhiteSpace(icon))
                    {
                        <i class="@icon me-2"></i>
                    }

                    @widget.WidgetTitle
                </div>

                <button type="button"
                        class="btn btn-sm btn-light refresh-widget-button"
                        data-widget-id="@widget.Id"
                        title="Refresh widget">

                    <i class="bi bi-arrow-clockwise"></i>

                </button>

            </div>

            <div class="card-body">

                @if (hasChartData)
                {
                    <div class="dashboard-chart-container"
                         style="height:@(height)px;">

                        <canvas id="@chartId"
                                role="img"
                                aria-label="@widget.WidgetTitle">
                        </canvas>

                    </div>
                }
                else
                {
                    <div class="text-muted d-flex justify-content-center align-items-center"
                         style="height:@(height)px;">

                        No chart data found.

                    </div>
                }

            </div>

        </div>

    </div>

    @if (hasChartData)
    {
        <script>
            (function () {

                const chartId =
                    @Html.Raw(
                        JsonSerializer.Serialize(
                            chartId));

                const chartElement =
                    document.getElementById(
                        chartId);

                if (!chartElement) {

                    console.error(
                        "Chart canvas was not found:",
                        chartId);

                    return;
                }

                if (typeof Chart === "undefined") {

                    console.error(
                        "Chart.js has not been loaded.");

                    return;
                }

                const existingChart =
                    Chart.getChart(
                        chartElement);

                if (existingChart) {

                    existingChart.destroy();
                }

                const chartType =
                    @Html.Raw(
                        JsonSerializer.Serialize(
                            chartType));

                const labels =
                    @Html.Raw(
                        JsonSerializer.Serialize(
                            labels));

                const values =
                    @Html.Raw(
                        JsonSerializer.Serialize(
                            values));

                const widgetTitle =
                    @Html.Raw(
                        JsonSerializer.Serialize(
                            widget.WidgetTitle));

                const showLegend =
                    @Html.Raw(
                        JsonSerializer.Serialize(
                            showLegend));

                const isCircularChart =
                    chartType === "pie" ||
                    chartType === "doughnut";

                const dataset = {
                    label:
                        widgetTitle,

                    data:
                        values,

                    borderWidth:
                        1
                };

                if (chartType === "line") {

                    dataset.tension =
                        0.25;

                    dataset.fill =
                        false;
                }

                new Chart(
                    chartElement,
                    {
                        type:
                            chartType,

                        data: {
                            labels:
                                labels,

                            datasets: [
                                dataset
                            ]
                        },

                        options: {
                            responsive:
                                true,

                            maintainAspectRatio:
                                false,

                            interaction: {
                                mode:
                                    "nearest",

                                intersect:
                                    false
                            },

                            plugins: {
                                legend: {
                                    display:
                                        showLegend,

                                    position:
                                        isCircularChart
                                            ? "right"
                                            : "top"
                                },

                                tooltip: {
                                    enabled:
                                        true
                                }
                            },

                            scales:
                                isCircularChart
                                    ? {}
                                    : {
                                        y: {
                                            beginAtZero:
                                                true,

                                            ticks: {
                                                precision:
                                                    0
                                            }
                                        }
                                    }
                        }
                    }
                );

            })();
        </script>
    }
}
else
{
    <div id="dashboardWidget_@widget.Id"
         class="col-md-@width dashboard-widget-container"
         data-widget-id="@widget.Id">

        <div class="card dashboard-card shadow-sm border-0 h-100">

            <div class="card-body d-flex justify-content-center align-items-center"
                 style="min-height:@(height)px;">

                <div class="text-muted text-center">

                    Unsupported widget type:

                    <strong>
                        @widget.WidgetType
                    </strong>

                </div>

            </div>

        </div>

    </div>
}
