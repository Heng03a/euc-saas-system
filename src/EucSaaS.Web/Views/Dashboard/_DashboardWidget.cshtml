@model EucSaaS.Web.ViewModels.Dashboard.DashboardWidgetViewModel

@{
    var widgetId =
        Model.Id.ToString("N");

    var widgetType =
        Model.WidgetType?.Trim()
        ?? "Card";

    var bootstrapColor =
        string.IsNullOrWhiteSpace(Model.Color)
            ? "primary"
            : Model.Color.Trim().ToLowerInvariant();

    var supportedBootstrapColors =
        new[]
        {
            "primary",
            "secondary",
            "success",
            "danger",
            "warning",
            "info",
            "light",
            "dark"
        };

    if (!supportedBootstrapColors.Contains(
            bootstrapColor,
            StringComparer.OrdinalIgnoreCase))
    {
        bootstrapColor = "primary";
    }

    var widgetWidth =
        Model.WidgetWidth;

    if (widgetWidth < 1 ||
        widgetWidth > 12)
    {
        widgetWidth = 6;
    }

    var widgetHeight =
        Model.Height;

    if (widgetHeight < 180)
    {
        widgetHeight = 260;
    }

    var isTable =
        string.Equals(
            widgetType,
            "Table",
            StringComparison.OrdinalIgnoreCase);

    var isChart =
        Model.ChartData != null;

    var iconClass =
        string.IsNullOrWhiteSpace(Model.Icon)
            ? "bi bi-grid"
            : Model.Icon.Trim();

    if (!iconClass.StartsWith(
            "bi ",
            StringComparison.OrdinalIgnoreCase))
    {
        iconClass =
            $"bi {iconClass}";
    }
}

<div id="dashboardWidget_@Model.Id"
     class="col-12 col-md-@widgetWidth dashboard-widget-column"
     data-widget-id="@Model.Id">

    <div class="card shadow-sm border-0 h-100 dashboard-widget-card">

        <div class="card-header bg-transparent border-0 pb-0">

            <div class="d-flex justify-content-between align-items-start">

                <div class="d-flex align-items-center gap-2">

                    <span class="dashboard-widget-icon
                                 text-@bootstrapColor">

                        <i class="@iconClass"></i>

                    </span>

                    <div>

                        <h5 class="card-title mb-0">
                            @Model.WidgetTitle
                        </h5>

                        <small class="text-muted">
                            @Model.WidgetCode
                        </small>

                    </div>

                </div>

                <button type="button"
                        class="btn btn-sm btn-outline-secondary
                               refresh-widget-button"
                        data-widget-id="@Model.Id"
                        title="Refresh widget"
                        aria-label="Refresh @Model.WidgetTitle">

                    <i class="bi bi-arrow-clockwise"></i>

                </button>

            </div>

        </div>

        <div class="card-body">

            @if (isChart)
            {
                <partial name="_DashboardChart"
                         model="Model" />
            }
            else if (isTable)
            {
                if (Model.Columns == null ||
                    Model.Columns.Count == 0)
                {
                    <div class="alert alert-light border mb-0">
                        No table columns were returned.
                    </div>
                }
                else
                {
                    <div class="table-responsive"
                         style="max-height:@($"{widgetHeight}px");">

                        <table class="table table-sm
                                      table-hover
                                      table-striped
                                      align-middle
                                      mb-0">

                            <thead class="table-light sticky-top">

                                <tr>

                                    @foreach (var column in Model.Columns)
                                    {
                                        <th scope="col"
                                            class="text-nowrap">
                                            @column
                                        </th>
                                    }

                                </tr>

                            </thead>

                            <tbody>

                                @if (Model.Rows == null ||
                                     Model.Rows.Count == 0)
                                {
                                    <tr>

                                        <td colspan="@Model.Columns.Count"
                                            class="text-center text-muted py-4">

                                            No records found.

                                        </td>

                                    </tr>
                                }
                                else
                                {
                                    foreach (var row in Model.Rows)
                                    {
                                        <tr>

                                            @foreach (var column in Model.Columns)
                                            {
                                                row.TryGetValue(
                                                    column,
                                                    out var cellValue);

                                                <td>
                                                    @cellValue
                                                </td>
                                            }

                                        </tr>
                                    }
                                }

                            </tbody>

                        </table>

                    </div>
                }
            }
            else
            {
                <div class="dashboard-card-value-container"
                     style="min-height:@($"{widgetHeight - 80}px");">

                    <div class="dashboard-card-value
                                text-@bootstrapColor">

                        @Model.Value

                    </div>

                </div>
            }

        </div>

    </div>

</div>
