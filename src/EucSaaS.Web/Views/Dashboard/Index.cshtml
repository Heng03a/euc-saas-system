@model EucSaaS.Web.ViewModels.Dashboard.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<h2 class="mb-4">
    Dashboard
</h2>

<div id="dashboardFullscreenArea"
     class="dashboard-fullscreen-area">

    <div class="card shadow-sm border-0 mb-4">

        <div class="card-body">

            <form id="dashboardFilterForm"
                  method="get"
                  asp-controller="Dashboard"
                  asp-action="Index">

                <div class="row g-3 align-items-end">

                    <!-- Department -->

                    <div class="col-md-4">

                        <label for="departmentFilter"
                               class="form-label fw-semibold">

                            Department

                        </label>

                        <select id="departmentFilter"
                                name="department"
                                class="form-select">

                            @if (Model.Filter.Departments.Count > 1)
                            {
                                <option value="">

                                    All Departments

                                </option>
                            }

                            @foreach (var department
                                in Model.Filter.Departments)
                            {
                                <option value="@department"
                                        selected="@(
                                            Model.Filter.Department ==
                                            department)">

                                    @department

                                </option>
                            }

                        </select>

                    </div>

                    <!-- Status -->

                    <div class="col-md-4">

                        <label for="statusFilter"
                               class="form-label fw-semibold">

                            Status

                        </label>

                        <select id="statusFilter"
                                name="status"
                                class="form-select">

                            <option value="">

                                All Statuses

                            </option>

                            @foreach (var status
                                in Model.Filter.Statuses)
                            {
                                <option value="@status"
                                        selected="@(
                                            Model.Filter.Status ==
                                            status)">

                                    @status

                                </option>
                            }

                        </select>

                    </div>

                    <!-- Controls -->

                    <div class="col-md-4">

                        <label for="autoRefreshInterval"
                               class="form-label fw-semibold">

                            Auto Refresh

                        </label>

                        <div class="d-flex gap-2 flex-wrap">

                            <select id="autoRefreshInterval"
                                    class="form-select"
                                    style="max-width:180px;">

                                <option value="0">
                                    Off
                                </option>

                                <option value="30">
                                    30 Seconds
                                </option>

                                <option value="60">
                                    1 Minute
                                </option>

                                <option value="300">
                                    5 Minutes
                                </option>

                                <option value="600">
                                    10 Minutes
                                </option>

                            </select>

                            <button id="refreshDashboardButton"
                                    type="submit"
                                    class="btn btn-primary"
                                    title="Refresh Dashboard">

                                <i class="bi bi-arrow-clockwise"></i>

                            </button>

                            <button id="clearDashboardButton"
                                    type="button"
                                    class="btn btn-outline-secondary">

                                Clear

                            </button>

                            <button id="fullscreenDashboardButton"
                                    type="button"
                                    class="btn btn-outline-dark"
                                    title="Open dashboard in fullscreen">

                                <i id="fullscreenDashboardIcon"
                                   class="bi bi-arrows-fullscreen">
                                </i>

                            </button>

                            <a id="exportExcelButton"
                               class="btn btn-success"
                               href="#"
                               title="Export Dashboard to Excel">

                                <i class="bi bi-file-earmark-excel"></i>

                                Export

                            </a>

                        </div>

                    </div>

                </div>

            </form>

        </div>

    </div>

    <div class="d-flex justify-content-between
                align-items-center
                mb-3">

        <div>

            <span class="badge bg-success">

                Dashboard Ready

            </span>

        </div>

        <small class="text-muted">

            Last Refreshed:

            <span id="lastRefreshedTime">

                @DateTime.Now.ToString(
                    "dd MMM yyyy HH:mm:ss")

            </span>

        </small>

    </div>

    <div id="dashboardLoading"
         class="text-center my-5"
         style="display:none;">

        <div class="spinner-border text-primary"
             role="status">

            <span class="visually-hidden">
                Loading...
            </span>

        </div>

        <div class="mt-2">

            Loading dashboard...

        </div>

    </div>

    <div id="dashboardError"
         class="alert alert-danger"
         style="display:none;">

        Dashboard could not be refreshed.

    </div>

    <div id="dashboardContent">

        <partial name="_DashboardContent"
                 model="Model" />

    </div>

</div>

<style>

    .dashboard-widget-card {
        border-radius: 0.75rem;
        transition:
            transform 0.15s ease-in-out,
            box-shadow 0.15s ease-in-out;
    }

    .dashboard-widget-card:hover {
        transform: translateY(-2px);
    }

    .dashboard-widget-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.25rem;
        height: 2.25rem;
        flex-shrink: 0;
        font-size: 1.25rem;
        border-radius: 0.5rem;
        background: var(--bs-tertiary-bg);
    }

    .dashboard-widget-column {
        min-width: 0;
    }

    .dashboard-card-value-container {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .dashboard-card-value {
        width: 100%;
        font-size: clamp(
            2rem,
            4vw,
            3.75rem
        );
        font-weight: 700;
        line-height: 1;
        text-align: center;
        overflow-wrap: anywhere;
    }

    .dashboard-table-wrapper {
        overflow: auto;
    }

    .dashboard-chart-wrapper {
        position: relative;
        width: 100%;
    }

    .dashboard-chart-wrapper canvas {
        width: 100% !important;
        height: 100% !important;
    }

    .dashboard-fullscreen-area:fullscreen {
        background: var(--bs-body-bg);
        padding: 24px;
        overflow: auto;
    }

    .dashboard-fullscreen-area:-webkit-full-screen {
        background: var(--bs-body-bg);
        padding: 24px;
        overflow: auto;
    }

</style>

@section Scripts
{
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.9/dist/chart.umd.min.js">
    </script>

    <script>

        $(document).ready(function () {

            const filterForm =
                $("#dashboardFilterForm");

            const departmentFilter =
                $("#departmentFilter");

            const statusFilter =
                $("#statusFilter");

            const dashboardContent =
                $("#dashboardContent");

            const dashboardLoading =
                $("#dashboardLoading");

            const dashboardError =
                $("#dashboardError");

            const refreshButton =
                $("#refreshDashboardButton");

            const clearButton =
                $("#clearDashboardButton");

            const autoRefreshInterval =
                $("#autoRefreshInterval");

            const lastRefreshedTime =
                $("#lastRefreshedTime");

            const exportExcelButton =
                $("#exportExcelButton");

            const fullscreenButton =
                $("#fullscreenDashboardButton");

            const fullscreenIcon =
                $("#fullscreenDashboardIcon");

            const fullscreenArea =
                document.getElementById(
                    "dashboardFullscreenArea"
                );

            let autoRefreshTimer = null;

            const dashboardChartInstances =
                new Map();

            function getChartColours() {

                return [
                    "rgba(13, 110, 253, 0.75)",
                    "rgba(25, 135, 84, 0.75)",
                    "rgba(255, 193, 7, 0.75)",
                    "rgba(220, 53, 69, 0.75)",
                    "rgba(13, 202, 240, 0.75)",
                    "rgba(111, 66, 193, 0.75)",
                    "rgba(253, 126, 20, 0.75)",
                    "rgba(32, 201, 151, 0.75)",
                    "rgba(108, 117, 125, 0.75)",
                    "rgba(214, 51, 132, 0.75)"
                ];
            }

            function getChartBorderColours() {

                return [
                    "rgb(13, 110, 253)",
                    "rgb(25, 135, 84)",
                    "rgb(255, 193, 7)",
                    "rgb(220, 53, 69)",
                    "rgb(13, 202, 240)",
                    "rgb(111, 66, 193)",
                    "rgb(253, 126, 20)",
                    "rgb(32, 201, 151)",
                    "rgb(108, 117, 125)",
                    "rgb(214, 51, 132)"
                ];
            }

            function normaliseChartType(
                chartType) {

                const supportedTypes =
                    [
                        "pie",
                        "bar",
                        "line",
                        "doughnut"
                    ];

                const normalisedType =
                    (
                        chartType ||
                        "bar"
                    )
                    .toString()
                    .trim()
                    .toLowerCase();

                return supportedTypes.includes(
                    normalisedType
                )
                    ? normalisedType
                    : "bar";
            }

            function repeatColours(
                colours,
                requiredLength) {

                const result = [];

                if (
                    !Array.isArray(colours) ||
                    colours.length === 0
                ) {

                    return result;
                }

                for (
                    let index = 0;
                    index < requiredLength;
                    index++
                ) {

                    result.push(
                        colours[
                            index %
                            colours.length
                        ]
                    );
                }

                return result;
            }

            function destroyDashboardCharts(
                container) {

                const root =
                    container instanceof HTMLElement
                        ? container
                        : document;

                const chartWrappers =
                    root.querySelectorAll(
                        '[data-dashboard-chart="true"]'
                    );

                chartWrappers.forEach(
                    function (wrapper) {

                        const chartId =
                            wrapper.getAttribute(
                                "data-chart-id"
                            );

                        if (!chartId) {

                            return;
                        }

                        const chartInstance =
                            dashboardChartInstances.get(
                                chartId
                            );

                        if (chartInstance) {

                            chartInstance.destroy();

                            dashboardChartInstances.delete(
                                chartId
                            );
                        }

                        const canvas =
                            document.getElementById(
                                chartId
                            );

                        if (
                            canvas &&
                            typeof Chart !== "undefined"
                        ) {

                            const existingChart =
                                Chart.getChart(
                                    canvas
                                );

                            if (existingChart) {

                                existingChart.destroy();
                            }
                        }
                    }
                );
            }

            function createDashboardChartOptions(
                chartType) {

                const isCircularChart =
                    chartType === "pie" ||
                    chartType === "doughnut";

                const options = {
                    responsive:
                        true,

                    maintainAspectRatio:
                        false,

                    animation: {
                        duration:
                            450
                    },

                    interaction: {
                        intersect:
                            false,

                        mode:
                            isCircularChart
                                ? "nearest"
                                : "index"
                    },

                    plugins: {
                        legend: {
                            display:
                                true,

                            position:
                                isCircularChart
                                    ? "right"
                                    : "top"
                        },

                        tooltip: {
                            enabled:
                                true
                        }
                    }
                };

                if (!isCircularChart) {

                    options.scales = {
                        x: {
                            grid: {
                                display:
                                    false
                            }
                        },

                        y: {
                            beginAtZero:
                                true
                        }
                    };
                }

                return options;
            }

            function initialiseDashboardCharts(
                container) {

                if (
                    typeof Chart === "undefined"
                ) {

                    console.error(
                        "Chart.js is not available."
                    );

                    return;
                }

                const root =
                    container instanceof HTMLElement
                        ? container
                        : document;

                const chartWrappers =
                    root.querySelectorAll(
                        '[data-dashboard-chart="true"]'
                    );

                chartWrappers.forEach(
                    function (wrapper) {

                        const chartId =
                            wrapper.getAttribute(
                                "data-chart-id"
                            );

                        const configurationId =
                            wrapper.getAttribute(
                                "data-configuration-id"
                            );

                        if (
                            !chartId ||
                            !configurationId
                        ) {

                            console.error(
                                "Dashboard chart metadata is incomplete."
                            );

                            return;
                        }

                        const canvas =
                            document.getElementById(
                                chartId
                            );

                        const configurationElement =
                            document.getElementById(
                                configurationId
                            );

                        if (
                            !canvas ||
                            !configurationElement
                        ) {

                            console.error(
                                "Dashboard chart elements were not found:",
                                chartId
                            );

                            return;
                        }

                        try {

                            const storedChart =
                                dashboardChartInstances.get(
                                    chartId
                                );

                            if (storedChart) {

                                storedChart.destroy();

                                dashboardChartInstances.delete(
                                    chartId
                                );
                            }

                            const chartJsInstance =
                                Chart.getChart(
                                    canvas
                                );

                            if (chartJsInstance) {

                                chartJsInstance.destroy();
                            }

                            const configurationText =
                                configurationElement
                                    .textContent
                                    ?.trim();

                            if (!configurationText) {

                                throw new Error(
                                    "Chart configuration is empty."
                                );
                            }

                            const chartConfiguration =
                                JSON.parse(
                                    configurationText
                                );

                            const chartType =
                                normaliseChartType(
                                    chartConfiguration.chartType
                                );

                            const labels =
                                Array.isArray(
                                    chartConfiguration.labels
                                )
                                    ? chartConfiguration.labels
                                    : [];

                            const values =
                                Array.isArray(
                                    chartConfiguration.values
                                )
                                    ? chartConfiguration.values
                                    : [];

                            const backgroundColours =
                                repeatColours(
                                    getChartColours(),
                                    values.length
                                );

                            const borderColours =
                                repeatColours(
                                    getChartBorderColours(),
                                    values.length
                                );

                            const isLineChart =
                                chartType === "line";

                            const isCircularChart =
                                chartType === "pie" ||
                                chartType === "doughnut";

                            const dataset = {
                                label:
                                    chartConfiguration.title
                                    || "Value",

                                data:
                                    values,

                                backgroundColor:
                                    isLineChart
                                        ? "rgba(13, 110, 253, 0.15)"
                                        : backgroundColours,

                                borderColor:
                                    isLineChart
                                        ? "rgb(13, 110, 253)"
                                        : borderColours,

                                borderWidth:
                                    isCircularChart
                                        ? 1
                                        : 2,

                                tension:
                                    isLineChart
                                        ? 0.25
                                        : 0
                            };

                            if (isLineChart) {

                                dataset.fill = false;

                                dataset.pointRadius = 4;

                                dataset.pointHoverRadius = 6;
                            }

                            const chartInstance =
                                new Chart(
                                    canvas,
                                    {
                                        type:
                                            chartType,

                                        data: {
                                            labels:
                                                labels,

                                            datasets:
                                                [
                                                    dataset
                                                ]
                                        },

                                        options:
                                            createDashboardChartOptions(
                                                chartType
                                            )
                                    }
                                );

                            dashboardChartInstances.set(
                                chartId,
                                chartInstance
                            );
                        }
                        catch (error) {

                            console.error(
                                "Dashboard chart could not be rendered:",
                                chartId,
                                error
                            );

                            wrapper.innerHTML =
                                '<div class="alert ' +
                                'alert-danger mb-0">' +
                                'The chart could not be rendered.' +
                                '</div>';
                        }
                    }
                );
            }

            function updateLastRefreshedTime() {

                const now =
                    new Date();

                const formattedTime =
                    now.toLocaleString(
                        "en-SG",
                        {
                            day:
                                "2-digit",

                            month:
                                "short",

                            year:
                                "numeric",

                            hour:
                                "2-digit",

                            minute:
                                "2-digit",

                            second:
                                "2-digit",

                            hour12:
                                false
                        }
                    );

                lastRefreshedTime.text(
                    formattedTime
                );
            }

            function updateExportUrl() {

                const department =
                    departmentFilter.val()
                    || "";

                const status =
                    statusFilter.val()
                    || "";

                const exportUrl =
                    "@Url.Action("ExportExcel", "Dashboard")"
                    + "?department="
                    + encodeURIComponent(
                        department
                    )
                    + "&status="
                    + encodeURIComponent(
                        status
                    );

                exportExcelButton.attr(
                    "href",
                    exportUrl
                );
            }

            function updateBrowserUrl(
                department,
                status) {

                const queryString =
                    new URLSearchParams();

                if (department) {

                    queryString.set(
                        "department",
                        department
                    );
                }

                if (status) {

                    queryString.set(
                        "status",
                        status
                    );
                }

                let newUrl =
                    "@Url.Action("Index", "Dashboard")";

                const query =
                    queryString.toString();

                if (query) {

                    newUrl +=
                        "?" + query;
                }

                window.history.replaceState(
                    {},
                    "",
                    newUrl
                );
            }

            function refreshDashboard() {

                const department =
                    departmentFilter.val()
                    || "";

                const status =
                    statusFilter.val()
                    || "";

                dashboardError.hide();

                dashboardLoading.show();

                dashboardContent.css(
                    "opacity",
                    "0.4"
                );

                refreshButton.prop(
                    "disabled",
                    true
                );

                clearButton.prop(
                    "disabled",
                    true
                );

                autoRefreshInterval.prop(
                    "disabled",
                    true
                );

                exportExcelButton.addClass(
                    "disabled"
                );

                $.ajax({
                    url:
                        "@Url.Action("Refresh", "Dashboard")",

                    type:
                        "GET",

                    data: {
                        department:
                            department,

                        status:
                            status
                    },

                    cache:
                        false,

                    success:
                        function (html) {

                            destroyDashboardCharts(
                                dashboardContent[0]
                            );

                            dashboardContent.html(
                                html
                            );

                            initialiseDashboardCharts(
                                dashboardContent[0]
                            );

                            updateBrowserUrl(
                                department,
                                status
                            );

                            updateExportUrl();

                            updateLastRefreshedTime();
                        },

                    error:
                        function (xhr) {

                            console.error(
                                "Dashboard refresh failed:",
                                xhr.responseText
                            );

                            dashboardError.show();
                        },

                    complete:
                        function () {

                            dashboardLoading.hide();

                            dashboardContent.css(
                                "opacity",
                                "1"
                            );

                            refreshButton.prop(
                                "disabled",
                                false
                            );

                            clearButton.prop(
                                "disabled",
                                false
                            );

                            autoRefreshInterval.prop(
                                "disabled",
                                false
                            );

                            exportExcelButton.removeClass(
                                "disabled"
                            );
                        }
                });
            }

            function stopAutoRefresh() {

                if (
                    autoRefreshTimer !== null
                ) {

                    clearInterval(
                        autoRefreshTimer
                    );

                    autoRefreshTimer =
                        null;
                }
            }

            function startAutoRefresh() {

                stopAutoRefresh();

                const intervalSeconds =
                    parseInt(
                        autoRefreshInterval.val(),
                        10
                    );

                if (
                    !intervalSeconds ||
                    intervalSeconds <= 0
                ) {

                    return;
                }

                autoRefreshTimer =
                    setInterval(
                        function () {

                            refreshDashboard();

                        },
                        intervalSeconds * 1000
                    );
            }

            function isDashboardFullscreen() {

                return (
                    document.fullscreenElement ===
                    fullscreenArea
                ) ||
                (
                    document.webkitFullscreenElement ===
                    fullscreenArea
                );
            }

            function updateFullscreenButton() {

                if (isDashboardFullscreen()) {

                    fullscreenIcon
                        .removeClass(
                            "bi-arrows-fullscreen"
                        )
                        .addClass(
                            "bi-fullscreen-exit"
                        );

                    fullscreenButton.attr(
                        "title",
                        "Exit fullscreen"
                    );
                }
                else {

                    fullscreenIcon
                        .removeClass(
                            "bi-fullscreen-exit"
                        )
                        .addClass(
                            "bi-arrows-fullscreen"
                        );

                    fullscreenButton.attr(
                        "title",
                        "Open dashboard in fullscreen"
                    );
                }
            }

            async function toggleDashboardFullscreen() {

                try {

                    if (!isDashboardFullscreen()) {

                        if (
                            fullscreenArea
                                .requestFullscreen
                        ) {

                            await fullscreenArea
                                .requestFullscreen();
                        }
                        else if (
                            fullscreenArea
                                .webkitRequestFullscreen
                        ) {

                            fullscreenArea
                                .webkitRequestFullscreen();
                        }
                    }
                    else {

                        if (
                            document.exitFullscreen
                        ) {

                            await document
                                .exitFullscreen();
                        }
                        else if (
                            document
                                .webkitExitFullscreen
                        ) {

                            document
                                .webkitExitFullscreen();
                        }
                    }
                }
                catch (error) {

                    console.error(
                        "Fullscreen operation failed:",
                        error
                    );

                    alert(
                        "Fullscreen mode is not available in this browser."
                    );
                }
            }

            filterForm.on(
                "submit",
                function (event) {

                    event.preventDefault();

                    refreshDashboard();
                }
            );

            departmentFilter.on(
                "change",
                function () {

                    refreshDashboard();
                }
            );

            statusFilter.on(
                "change",
                function () {

                    refreshDashboard();
                }
            );

            autoRefreshInterval.on(
                "change",
                function () {

                    startAutoRefresh();
                }
            );

            clearButton.on(
                "click",
                function () {

                    if (
                        departmentFilter
                            .find("option")
                            .length > 1
                    ) {

                        departmentFilter.val("");
                    }
                    else {

                        departmentFilter.prop(
                            "selectedIndex",
                            0
                        );
                    }

                    statusFilter.val("");

                    updateExportUrl();

                    refreshDashboard();
                }
            );

            fullscreenButton.on(
                "click",
                function () {

                    toggleDashboardFullscreen();
                }
            );

            document.addEventListener(
                "fullscreenchange",
                function () {

                    updateFullscreenButton();
                }
            );

            document.addEventListener(
                "webkitfullscreenchange",
                function () {

                    updateFullscreenButton();
                }
            );

            /*
             * Widget-level AJAX refresh.
             *
             * Event delegation is required because widgets
             * are dynamically replaced after AJAX requests.
             */
            $(document).on(
                "click",
                ".refresh-widget-button",
                function () {

                    const button =
                        $(this);

                    const widgetId =
                        button.attr(
                            "data-widget-id"
                        );

                    if (!widgetId) {

                        console.error(
                            "Widget ID is missing."
                        );

                        return;
                    }

                    const widgetContainer =
                        $("#dashboardWidget_" + widgetId);

                    if (
                        widgetContainer.length === 0
                    ) {

                        console.error(
                            "Widget container was not found:",
                            widgetId
                        );

                        return;
                    }

                    const department =
                        departmentFilter.val()
                        || "";

                    const status =
                        statusFilter.val()
                        || "";

                    const originalButtonHtml =
                        button.html();

                    button.prop(
                        "disabled",
                        true
                    );

                    button.html(
                        '<span class="spinner-border ' +
                        'spinner-border-sm" ' +
                        'role="status" ' +
                        'aria-hidden="true"></span>'
                    );

                    widgetContainer.css(
                        "opacity",
                        "0.45"
                    );

                    $.ajax({
                        url:
                            "@Url.Action(
                                "RefreshWidget",
                                "Dashboard")",

                        type:
                            "GET",

                        data: {
                            id:
                                widgetId,

                            department:
                                department,

                            status:
                                status
                        },

                        cache:
                            false,

                        success:
                            function (html) {

                                destroyDashboardCharts(
                                    widgetContainer[0]
                                );

                                widgetContainer.replaceWith(
                                    html
                                );

                                const refreshedWidgetContainer =
                                    document.getElementById(
                                        "dashboardWidget_" +
                                        widgetId
                                    );

                                if (
                                    refreshedWidgetContainer
                                ) {

                                    initialiseDashboardCharts(
                                        refreshedWidgetContainer
                                    );
                                }

                                updateLastRefreshedTime();
                            },

                        error:
                            function (xhr) {

                                console.error(
                                    "Widget refresh failed:",
                                    xhr.responseText
                                );

                                widgetContainer.css(
                                    "opacity",
                                    "1"
                                );

                                button.prop(
                                    "disabled",
                                    false
                                );

                                button.html(
                                    originalButtonHtml
                                );

                                alert(
                                    "The widget could not be refreshed."
                                );
                            },

                        complete:
                            function () {

                                const currentContainer =
                                    $(
                                        "#dashboardWidget_" +
                                        widgetId
                                    );

                                if (
                                    currentContainer.length === 0
                                ) {

                                    return;
                                }

                                currentContainer.css(
                                    "opacity",
                                    "1"
                                );

                                const currentButton =
                                    currentContainer.find(
                                        ".refresh-widget-button"
                                    );

                                currentButton.prop(
                                    "disabled",
                                    false
                                );
                            }
                    });
                }
            );

            /*
             * Prevent export when the button is temporarily
             * disabled during dashboard refresh.
             */
            exportExcelButton.on(
                "click",
                function (event) {

                    if (
                        exportExcelButton.hasClass(
                            "disabled"
                        )
                    ) {

                        event.preventDefault();
                    }
                }
            );

            /*
             * Stop refresh timers and destroy charts before
             * leaving the page.
             */
            $(window).on(
                "beforeunload",
                function () {

                    stopAutoRefresh();

                    destroyDashboardCharts(
                        dashboardContent[0]
                    );
                }
            );

            /*
             * Initial page setup.
             */
            updateExportUrl();

            updateFullscreenButton();

            initialiseDashboardCharts(
                dashboardContent[0]
            );
        });

    </script>
}
