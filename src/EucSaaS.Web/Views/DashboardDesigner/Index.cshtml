@model EucSaaS.Web.ViewModels.Dashboard.DashboardDesignerIndexViewModel

@{
    ViewData["Title"] = "Dashboard Designer";
}

<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-3">
    <div>
        <h2 class="mb-1">Dashboard Designer</h2>

        <p class="text-muted mb-0">
            Search and filter widgets, or drag them by the handle icon
            to reorder the dashboard layout.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-success">
        <i class="bi bi-plus-circle me-1"></i>
        Create Widget
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">
        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

<div id="saveMessage"
     class="alert alert-success d-none"
     role="alert">
</div>

@* ------------------------------------------------------------
   Search and filters
   ------------------------------------------------------------ *@
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form method="get"
              asp-controller="DashboardDesigner"
              asp-action="Index"
              id="widgetFilterForm">

            <div class="row g-3 align-items-end">

                <div class="col-12 col-lg-4">
                    <label asp-for="Filter.Search"
                           class="form-label">
                        Search widgets
                    </label>

                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>

                        <input asp-for="Filter.Search"
                               name="Search"
                               class="form-control"
                               placeholder="Code, title, type or template..." />
                    </div>
                </div>

                <div class="col-12 col-md-4 col-lg-2">
                    <label asp-for="Filter.WidgetType"
                           class="form-label">
                        Widget type
                    </label>

                    <select asp-for="Filter.WidgetType"
                            name="WidgetType"
                            asp-items="Model.WidgetTypes"
                            class="form-select auto-submit-filter">
                        <option value="">All types</option>
                    </select>
                </div>

                <div class="col-12 col-md-4 col-lg-2">
                    <label asp-for="Filter.IsActive"
                           class="form-label">
                        Status
                    </label>

                    <select asp-for="Filter.IsActive"
                            name="IsActive"
                            class="form-select auto-submit-filter">
                        <option value="">All statuses</option>
                        <option value="true">Active</option>
                        <option value="false">Inactive</option>
                    </select>
                </div>

                <div class="col-12 col-md-4 col-lg-2">
                    <label asp-for="Filter.DashboardTemplateId"
                           class="form-label">
                        Template
                    </label>

                    <select asp-for="Filter.DashboardTemplateId"
                            name="DashboardTemplateId"
                            asp-items="Model.DashboardTemplates"
                            class="form-select auto-submit-filter">
                        <option value="">All templates</option>
                    </select>
                </div>

                <div class="col-12 col-lg-2">
                    <div class="d-flex gap-2">
                        <button type="submit"
                                class="btn btn-primary flex-grow-1">
                            <i class="bi bi-search me-1"></i>
                            Search
                        </button>

                        <a asp-controller="DashboardDesigner"
                           asp-action="Index"
                           class="btn btn-outline-secondary"
                           title="Clear all filters">
                            <i class="bi bi-x-lg"></i>
                        </a>
                    </div>
                </div>

            </div>
        </form>
    </div>
</div>

@* ------------------------------------------------------------
   Results toolbar
   ------------------------------------------------------------ *@
<div class="d-flex flex-wrap justify-content-between
            align-items-center gap-2 mb-3">

    <div class="text-muted">
        <strong>@Model.Widgets.Count</strong>
        widget(s) found
    </div>

    <button type="button"
            id="saveLayoutBtn"
            class="btn btn-primary"
            disabled>
        <i class="bi bi-save me-1"></i>
        Save Layout
    </button>
</div>

@Html.AntiForgeryToken()

@if (!Model.Widgets.Any())
{
    <div class="alert alert-info">
        <div class="d-flex align-items-start gap-2">
            <i class="bi bi-info-circle fs-5"></i>

            <div>
                <strong>No widgets found.</strong>

                <div>
                    Try changing the search text or clearing one or more
                    filters.
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div id="dashboardDesignerList"
         class="row g-3">

        @foreach (var widget in Model.Widgets
            .OrderBy(x => x.RowPosition)
            .ThenBy(x => x.ColumnPosition)
            .ThenBy(x => x.DisplayOrder))
        {
            var width =
                widget.WidgetWidth <= 0
                    ? 4
                    : widget.WidgetWidth;

            var height =
                widget.Height <= 0
                    ? 300
                    : widget.Height;

            var statusClass =
                widget.IsActive
                    ? "bg-success"
                    : "bg-secondary";

            <div class="col-md-@width dashboard-widget-item"
                 data-widget-id="@widget.Id"
                 data-row-position="@widget.RowPosition"
                 data-column-position="@widget.ColumnPosition"
                 data-widget-width="@width"
                 data-height="@height">

                <div class="card shadow-sm h-100">

                    <div class="card-header bg-light
                                d-flex justify-content-between
                                align-items-center">

                        <div class="d-flex align-items-center">
                            <span class="drag-handle me-2"
                                  title="Drag widget"
                                  aria-label="Drag widget">
                                ☰
                            </span>

                            <strong>@widget.WidgetCode</strong>
                        </div>

                        <span class="badge @statusClass">
                            @(widget.IsActive ? "Active" : "Inactive")
                        </span>
                    </div>

                    <div class="card-body">
                        <h5 class="card-title">
                            @widget.WidgetName
                        </h5>

                        <p class="mb-1">
                            <strong>Template:</strong>
                            @(string.IsNullOrWhiteSpace(
                                widget.DashboardTemplateName)
                                ? "Not assigned"
                                : widget.DashboardTemplateName)
                        </p>

                        <p class="mb-1">
                            <strong>Type:</strong>
                            @widget.WidgetType
                        </p>

                        <p class="mb-1">
                            <strong>Width:</strong>
                            @widget.WidgetWidth
                        </p>

                        <p class="mb-1">
                            <strong>Row:</strong>
                            @widget.RowPosition
                        </p>

                        <p class="mb-1">
                            <strong>Column:</strong>
                            @widget.ColumnPosition
                        </p>

                        <p class="mb-1">
                            <strong>Height:</strong>
                            @widget.Height
                        </p>

                        <p class="mb-0">
                            <strong>Order:</strong>
                            @widget.DisplayOrder
                        </p>
                    </div>

                    <div class="card-footer">
                        <div class="d-flex flex-wrap
                                    justify-content-end gap-2">

                            <a asp-action="Edit"
                               asp-route-id="@widget.Id"
                               class="btn btn-sm btn-primary">
                                <i class="bi bi-pencil-square me-1"></i>
                                Edit
                            </a>

                            <form asp-action="Clone"
                                  asp-route-id="@widget.Id"
                                  method="post"
                                  class="d-inline">
                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-sm btn-warning">
                                    <i class="bi bi-files me-1"></i>
                                    Clone
                                </button>
                            </form>

                            <form asp-action="Delete"
                                  asp-route-id="@widget.Id"
                                  method="post"
                                  class="d-inline delete-widget-form">
                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-sm btn-danger">
                                    <i class="bi bi-trash me-1"></i>
                                    Delete
                                </button>
                            </form>

                        </div>
                    </div>

                </div>
            </div>
        }

    </div>
}

<style>
    .drag-handle {
        cursor: grab;
        user-select: none;
        font-size: 22px;
        line-height: 1;
        color: #6c757d;
    }

    .drag-handle:active {
        cursor: grabbing;
    }

    .dashboard-widget-item.sortable-chosen .card {
        border: 2px solid #0d6efd;
    }

    .dashboard-widget-item.sortable-ghost {
        opacity: 0.5;
    }

    .dashboard-widget-item .card {
        transition:
            transform 0.15s ease,
            box-shadow 0.15s ease;
    }

    .dashboard-widget-item .card:hover {
        transform: translateY(-2px);
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const filterForm =
                document.getElementById("widgetFilterForm");

            const autoSubmitFilters =
                document.querySelectorAll(".auto-submit-filter");

            autoSubmitFilters.forEach(function (filter) {
                filter.addEventListener("change", function () {
                    if (filterForm) {
                        filterForm.submit();
                    }
                });
            });

            const deleteForms =
                document.querySelectorAll(".delete-widget-form");

            deleteForms.forEach(function (form) {
                form.addEventListener("submit", function (event) {
                    const confirmed = window.confirm(
                        "Are you sure you want to delete this dashboard widget?"
                    );

                    if (!confirmed) {
                        event.preventDefault();
                    }
                });
            });

            const designerList =
                document.getElementById("dashboardDesignerList");

            const saveButton =
                document.getElementById("saveLayoutBtn");

            const messageBox =
                document.getElementById("saveMessage");

            if (!designerList || !saveButton || !messageBox) {
                return;
            }

            saveButton.disabled = true;

            new Sortable(designerList, {
                animation: 150,
                handle: ".drag-handle",
                ghostClass: "sortable-ghost",
                chosenClass: "sortable-chosen",
                dragClass: "shadow-lg",

                onEnd: function () {
                    saveButton.disabled = false;

                    messageBox.innerText =
                        "Layout has unsaved changes.";

                    messageBox.classList.remove(
                        "d-none",
                        "alert-success"
                    );

                    messageBox.classList.add(
                        "alert-warning"
                    );
                }
            });

            saveButton.addEventListener("click", function () {
                const widgets =
                    document.querySelectorAll(
                        ".dashboard-widget-item"
                    );

                const layoutItems = [];

                widgets.forEach(function (item, index) {
                    layoutItems.push({
                        widgetId:
                            item.getAttribute(
                                "data-widget-id"
                            ),

                        rowPosition: 1,

                        columnPosition:
                            index + 1,

                        widgetWidth:
                            parseInt(
                                item.getAttribute(
                                    "data-widget-width"
                                )
                            ) || 4,

                        height:
                            parseInt(
                                item.getAttribute(
                                    "data-height"
                                )
                            ) || 300,

                        displayOrder:
                            index + 1
                    });
                });

                const tokenInput =
                    document.querySelector(
                        'input[name="__RequestVerificationToken"]'
                    );

                if (!tokenInput) {
                    alert(
                        "The anti-forgery token was not found."
                    );

                    return;
                }

                saveButton.disabled = true;

                fetch("/DashboardDesigner/SaveLayout", {
                    method: "POST",

                    headers: {
                        "Content-Type":
                            "application/json",

                        "RequestVerificationToken":
                            tokenInput.value
                    },

                    body:
                        JSON.stringify(layoutItems)
                })
                .then(async function (response) {
                    if (!response.ok) {
                        const errorText =
                            await response.text();

                        throw new Error(
                            errorText ||
                            "Save layout failed."
                        );
                    }

                    return response.json();
                })
                .then(function (data) {
                    messageBox.innerText =
                        data.message;

                    messageBox.classList.remove(
                        "d-none",
                        "alert-warning"
                    );

                    messageBox.classList.add(
                        "alert-success"
                    );

                    saveButton.disabled = true;

                    setTimeout(function () {
                        window.location.reload();
                    }, 800);
                })
                .catch(function (error) {
                    messageBox.innerText =
                        error.message;

                    messageBox.classList.remove(
                        "d-none",
                        "alert-success"
                    );

                    messageBox.classList.add(
                        "alert-danger"
                    );

                    saveButton.disabled = false;
                });
            });
        });
    </script>
}
