@model EucSaaS.Web.ViewModels.Dashboard.DashboardDesignerIndexViewModel

@{
    ViewData["Title"] = "Dashboard Designer";

    var hasNonLayoutSorting =
        !string.Equals(
            Model.Filter.SortBy,
            "displayorder",
            StringComparison.OrdinalIgnoreCase) ||
        !string.Equals(
            Model.Filter.SortDirection,
            "asc",
            StringComparison.OrdinalIgnoreCase);

    var canEditLayout =
        Model.CanEditLayout &&
        !hasNonLayoutSorting;

    var firstPageNumber =
        Math.Max(
            1,
            Model.CurrentPage - 2);

    var lastPageNumber =
        Math.Min(
            Model.TotalPages,
            Model.CurrentPage + 2);
}

<div class="d-flex flex-wrap justify-content-between
            align-items-start gap-3 mb-3">

    <div>
        <h2 class="mb-1">
            Dashboard Designer
        </h2>

        <p class="text-muted mb-0">
            Search, filter, sort and manage dashboard widgets.
            Select Show all with the default layout order to enable
            drag-and-drop layout editing.
        </p>
    </div>

    <a asp-action="Create"
       class="btn btn-success">

        <i class="bi bi-plus-circle me-1"></i>
        Create Widget
    </a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"
         role="alert">

        @TempData["SuccessMessage"]

        <button type="button"
                class="btn-close"
                data-bs-dismiss="alert"
                aria-label="Close">
        </button>
    </div>
}

<div id="saveMessage"
     class="alert alert-success d-none"
     role="alert">
</div>

@* ============================================================
   Search, filters, sorting and page size
   ============================================================ *@

<div class="card shadow-sm mb-4">
    <div class="card-body">

        <form method="get"
              asp-controller="DashboardDesigner"
              asp-action="Index"
              id="widgetFilterForm">

            @* Every new search or filter starts from page 1. *@
            <input type="hidden"
                   name="Page"
                   value="1" />

            <div class="row g-3 align-items-end">

                <div class="col-12 col-xl-4">
                    <label asp-for="Filter.Search"
                           class="form-label">
                        Search widgets
                    </label>

                    <div class="input-group">

                        <span class="input-group-text">
                            <i class="bi bi-search"></i>
                        </span>

                        <input asp-for="Filter.Search"
                               name="Search"
                               class="form-control"
                               placeholder="Code, title, type or template..." />
                    </div>
                </div>

                <div class="col-12 col-md-4 col-xl-2">
                    <label asp-for="Filter.WidgetType"
                           class="form-label">
                        Widget type
                    </label>

                    <select asp-for="Filter.WidgetType"
                            name="WidgetType"
                            asp-items="Model.WidgetTypes"
                            class="form-select auto-submit-filter">

                        <option value="">
                            All types
                        </option>
                    </select>
                </div>

                <div class="col-12 col-md-4 col-xl-2">
                    <label asp-for="Filter.IsActive"
                           class="form-label">
                        Status
                    </label>

                    <select asp-for="Filter.IsActive"
                            name="IsActive"
                            class="form-select auto-submit-filter">

                        <option value="">
                            All statuses
                        </option>

                        <option value="true">
                            Active
                        </option>

                        <option value="false">
                            Inactive
                        </option>
                    </select>
                </div>

                <div class="col-12 col-md-4 col-xl-2">
                    <label asp-for="Filter.DashboardTemplateId"
                           class="form-label">
                        Template
                    </label>

                    <select asp-for="Filter.DashboardTemplateId"
                            name="DashboardTemplateId"
                            asp-items="Model.DashboardTemplates"
                            class="form-select auto-submit-filter">

                        <option value="">
                            All templates
                        </option>
                    </select>
                </div>

                <div class="col-12 col-xl-2">
                    <div class="d-flex gap-2">

                        <button type="submit"
                                class="btn btn-primary flex-grow-1">

                            <i class="bi bi-search me-1"></i>
                            Search
                        </button>

<a asp-controller="DashboardDesigner"
   asp-action="Index"
   asp-route-Page="1"
   asp-route-PageSize="0"
   asp-route-SortBy="displayorder"
   asp-route-SortDirection="asc"
   class="btn btn-outline-secondary"
   title="Clear all filters and enable layout editing">

    <i class="bi bi-x-lg"></i>
</a>
                    </div>
                </div>
            </div>

            <hr class="my-4" />

            <div class="row g-3 align-items-end">

                <div class="col-12 col-md-4">
                    <label asp-for="Filter.SortBy"
                           class="form-label">
                        Sort by
                    </label>

                    <select asp-for="Filter.SortBy"
                            name="SortBy"
                            asp-items="Model.SortOptions"
                            class="form-select auto-submit-filter">
                    </select>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="Filter.SortDirection"
                           class="form-label">
                        Sort direction
                    </label>

                    <select asp-for="Filter.SortDirection"
                            name="SortDirection"
                            class="form-select auto-submit-filter">

                        <option value="asc">
                            Ascending
                        </option>

                        <option value="desc">
                            Descending
                        </option>
                    </select>
                </div>

                <div class="col-12 col-md-4">
                    <label asp-for="Filter.PageSize"
                           class="form-label">
                        Page size
                    </label>

                    <select asp-for="Filter.PageSize"
                            name="PageSize"
                            asp-items="Model.PageSizeOptions"
                            class="form-select auto-submit-filter">
                    </select>
                </div>
            </div>
        </form>
    </div>
</div>

@* ============================================================
   Results toolbar
   ============================================================ *@

<div class="d-flex flex-wrap justify-content-between
            align-items-center gap-3 mb-3">

    <div>
        @if (Model.TotalItems == 0)
        {
            <div class="text-muted">
                <strong>0</strong> widgets found
            </div>
        }
        else
        {
            <div class="text-muted">
                Showing
                <strong>@Model.StartItem</strong>
                to
                <strong>@Model.EndItem</strong>
                of
                <strong>@Model.TotalItems</strong>
                widgets
            </div>

            @if (!Model.IsShowingAll)
            {
                <div class="small text-muted mt-1">
                    Page @Model.CurrentPage of @Model.TotalPages
                </div>
            }
        }
    </div>

    <button type="button"
            id="saveLayoutBtn"
            class="btn btn-primary"
            disabled>

        <i class="bi bi-save me-1"></i>
        Save Layout
    </button>
</div>

@* ============================================================
   Layout safety message
   ============================================================ *@

@if (Model.Widgets.Any() && !canEditLayout)
{
    <div class="alert alert-warning py-2">
        <div class="d-flex align-items-start gap-2">

            <i class="bi bi-lock-fill"></i>

            <div>
                <strong>Layout editing is currently locked.</strong>

                <div class="small">
                    Clear all filters, select
                    <strong>Display order</strong>,
                    select
                    <strong>Ascending</strong>,
                    and choose
                    <strong>Show all</strong>
                    to enable drag-and-drop and Save Layout.
                </div>
            </div>
        </div>
    </div>
}
else if (Model.Widgets.Any() && canEditLayout)
{
    <div class="alert alert-info py-2">
        <div class="d-flex align-items-start gap-2">

            <i class="bi bi-arrows-move"></i>

            <div class="small">
                Drag widgets using the handle icon. Save Layout becomes
                available after the order changes.
            </div>
        </div>
    </div>
}

@Html.AntiForgeryToken()

@* ============================================================
   Empty result
   ============================================================ *@

@if (!Model.Widgets.Any())
{
    <div class="alert alert-info">

        <div class="d-flex align-items-start gap-2">

            <i class="bi bi-info-circle fs-5"></i>

            <div>
                <strong>No widgets found.</strong>

                <div>
                    Try changing the search text or clearing one or more
                    filters.
                </div>
            </div>
        </div>
    </div>
}
else
{
    @* ========================================================
       Widget cards

       Do not apply another OrderBy here. The query service has
       already applied the selected server-side sorting.
       ======================================================== *@

    <div id="dashboardDesignerList"
         class="row g-3">

        @foreach (var widget in Model.Widgets)
        {
            var width =
                widget.WidgetWidth <= 0
                    ? 4
                    : widget.WidgetWidth;

            var height =
                widget.Height <= 0
                    ? 300
                    : widget.Height;

            var statusClass =
                widget.IsActive
                    ? "bg-success"
                    : "bg-secondary";

            var dragHandleClass =
                canEditLayout
                    ? "drag-handle"
                    : "drag-handle drag-handle-disabled";

            var dragTitle =
                canEditLayout
                    ? "Drag widget"
                    : "Layout editing is locked";

            <div class="col-md-@width dashboard-widget-item"
                 data-widget-id="@widget.Id"
                 data-row-position="@widget.RowPosition"
                 data-column-position="@widget.ColumnPosition"
                 data-widget-width="@width"
                 data-height="@height">

                <div class="card shadow-sm h-100">

                    <div class="card-header bg-light
                                d-flex justify-content-between
                                align-items-center gap-2">

                        <div class="d-flex align-items-center
                                    overflow-hidden">

                            <span class="@dragHandleClass me-2"
                                  title="@dragTitle"
                                  aria-label="@dragTitle">

                                ☰
                            </span>

                            <strong class="text-truncate">
                                @widget.WidgetCode
                            </strong>
                        </div>

                        <span class="badge @statusClass">
                            @(widget.IsActive
                                ? "Active"
                                : "Inactive")
                        </span>
                    </div>

                    <div class="card-body">

                        <h5 class="card-title">
                            @widget.WidgetName
                        </h5>

                        <p class="mb-1">
                            <strong>Template:</strong>

                            @(string.IsNullOrWhiteSpace(
                                widget.DashboardTemplateName)
                                ? "Not assigned"
                                : widget.DashboardTemplateName)
                        </p>

                        <p class="mb-1">
                            <strong>Type:</strong>
                            @widget.WidgetType
                        </p>

                        <p class="mb-1">
                            <strong>Width:</strong>
                            @widget.WidgetWidth
                        </p>

                        <p class="mb-1">
                            <strong>Row:</strong>
                            @widget.RowPosition
                        </p>

                        <p class="mb-1">
                            <strong>Column:</strong>
                            @widget.ColumnPosition
                        </p>

                        <p class="mb-1">
                            <strong>Height:</strong>
                            @widget.Height
                        </p>

                        <p class="mb-0">
                            <strong>Order:</strong>
                            @widget.DisplayOrder
                        </p>
                    </div>

                    <div class="card-footer">

                        <div class="d-flex flex-wrap
                                    justify-content-end gap-2">

                            <a asp-action="Edit"
                               asp-route-id="@widget.Id"
                               class="btn btn-sm btn-primary">

                                <i class="bi bi-pencil-square me-1"></i>
                                Edit
                            </a>

                            <form asp-action="Clone"
                                  asp-route-id="@widget.Id"
                                  method="post"
                                  class="d-inline">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-sm btn-warning">

                                    <i class="bi bi-files me-1"></i>
                                    Clone
                                </button>
                            </form>

                            <form asp-action="Delete"
                                  asp-route-id="@widget.Id"
                                  method="post"
                                  class="d-inline delete-widget-form">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-sm btn-danger">

                                    <i class="bi bi-trash me-1"></i>
                                    Delete
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@* ============================================================
   Pagination
   ============================================================ *@

@if (Model.TotalItems > 0 &&
     !Model.IsShowingAll &&
     Model.TotalPages > 1)
{
    <nav class="mt-4"
         aria-label="Dashboard widget pagination">

        <ul class="pagination justify-content-center flex-wrap">

            @* First page *@
            @if (Model.HasPreviousPage)
            {
                <li class="page-item">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-Search="@Model.Filter.Search"
                       asp-route-WidgetType="@Model.Filter.WidgetType"
                       asp-route-IsActive="@Model.Filter.IsActive"
                       asp-route-DashboardTemplateId="@Model.Filter.DashboardTemplateId"
                       asp-route-SortBy="@Model.Filter.SortBy"
                       asp-route-SortDirection="@Model.Filter.SortDirection"
                       asp-route-PageSize="@Model.PageSize"
                       asp-route-Page="1">

                        <i class="bi bi-chevron-double-left"></i>
                        <span class="d-none d-sm-inline ms-1">
                            First
                        </span>
                    </a>
                </li>

                <li class="page-item">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-Search="@Model.Filter.Search"
                       asp-route-WidgetType="@Model.Filter.WidgetType"
                       asp-route-IsActive="@Model.Filter.IsActive"
                       asp-route-DashboardTemplateId="@Model.Filter.DashboardTemplateId"
                       asp-route-SortBy="@Model.Filter.SortBy"
                       asp-route-SortDirection="@Model.Filter.SortDirection"
                       asp-route-PageSize="@Model.PageSize"
                       asp-route-Page="@(Model.CurrentPage - 1)">

                        <i class="bi bi-chevron-left"></i>
                        <span class="d-none d-sm-inline ms-1">
                            Previous
                        </span>
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">
                        <i class="bi bi-chevron-double-left"></i>
                        <span class="d-none d-sm-inline ms-1">
                            First
                        </span>
                    </span>
                </li>

                <li class="page-item disabled">
                    <span class="page-link">
                        <i class="bi bi-chevron-left"></i>
                        <span class="d-none d-sm-inline ms-1">
                            Previous
                        </span>
                    </span>
                </li>
            }

            @* Numbered pages *@
            @for (var pageNumber = firstPageNumber;
                  pageNumber <= lastPageNumber;
                  pageNumber++)
            {
                if (pageNumber == Model.CurrentPage)
                {
                    <li class="page-item active"
                        aria-current="page">

                        <span class="page-link">
                            @pageNumber
                        </span>
                    </li>
                }
                else
                {
                    <li class="page-item">

                        <a class="page-link"
                           asp-action="Index"
                           asp-route-Search="@Model.Filter.Search"
                           asp-route-WidgetType="@Model.Filter.WidgetType"
                           asp-route-IsActive="@Model.Filter.IsActive"
                           asp-route-DashboardTemplateId="@Model.Filter.DashboardTemplateId"
                           asp-route-SortBy="@Model.Filter.SortBy"
                           asp-route-SortDirection="@Model.Filter.SortDirection"
                           asp-route-PageSize="@Model.PageSize"
                           asp-route-Page="@pageNumber">

                            @pageNumber
                        </a>
                    </li>
                }
            }

            @* Next and last page *@
            @if (Model.HasNextPage)
            {
                <li class="page-item">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-Search="@Model.Filter.Search"
                       asp-route-WidgetType="@Model.Filter.WidgetType"
                       asp-route-IsActive="@Model.Filter.IsActive"
                       asp-route-DashboardTemplateId="@Model.Filter.DashboardTemplateId"
                       asp-route-SortBy="@Model.Filter.SortBy"
                       asp-route-SortDirection="@Model.Filter.SortDirection"
                       asp-route-PageSize="@Model.PageSize"
                       asp-route-Page="@(Model.CurrentPage + 1)">

                        <span class="d-none d-sm-inline me-1">
                            Next
                        </span>
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </li>

                <li class="page-item">

                    <a class="page-link"
                       asp-action="Index"
                       asp-route-Search="@Model.Filter.Search"
                       asp-route-WidgetType="@Model.Filter.WidgetType"
                       asp-route-IsActive="@Model.Filter.IsActive"
                       asp-route-DashboardTemplateId="@Model.Filter.DashboardTemplateId"
                       asp-route-SortBy="@Model.Filter.SortBy"
                       asp-route-SortDirection="@Model.Filter.SortDirection"
                       asp-route-PageSize="@Model.PageSize"
                       asp-route-Page="@Model.TotalPages">

                        <span class="d-none d-sm-inline me-1">
                            Last
                        </span>
                        <i class="bi bi-chevron-double-right"></i>
                    </a>
                </li>
            }
            else
            {
                <li class="page-item disabled">
                    <span class="page-link">
                        <span class="d-none d-sm-inline me-1">
                            Next
                        </span>
                        <i class="bi bi-chevron-right"></i>
                    </span>
                </li>

                <li class="page-item disabled">
                    <span class="page-link">
                        <span class="d-none d-sm-inline me-1">
                            Last
                        </span>
                        <i class="bi bi-chevron-double-right"></i>
                    </span>
                </li>
            }
        </ul>
    </nav>
}

<style>
    .drag-handle {
        cursor: grab;
        user-select: none;
        font-size: 22px;
        line-height: 1;
        color: #6c757d;
    }

    .drag-handle:active {
        cursor: grabbing;
    }

    .drag-handle-disabled {
        cursor: not-allowed;
        opacity: 0.45;
    }

    .dashboard-widget-item.sortable-chosen .card {
        border: 2px solid #0d6efd;
    }

    .dashboard-widget-item.sortable-ghost {
        opacity: 0.5;
    }

    .dashboard-widget-item .card {
        transition:
            transform 0.15s ease,
            box-shadow 0.15s ease;
    }

    .dashboard-widget-item .card:hover {
        transform: translateY(-2px);
    }

    .pagination .page-link {
        min-width: 42px;
        text-align: center;
    }
</style>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js">
    </script>

    <script>
        document.addEventListener(
            "DOMContentLoaded",
            function () {

                const canEditLayout =
                    @canEditLayout.ToString().ToLowerInvariant();

                const filterForm =
                    document.getElementById(
                        "widgetFilterForm"
                    );

                const autoSubmitFilters =
                    document.querySelectorAll(
                        ".auto-submit-filter"
                    );

                autoSubmitFilters.forEach(
                    function (filter) {

                        filter.addEventListener(
                            "change",
                            function () {

                                if (filterForm) {
                                    filterForm.submit();
                                }
                            }
                        );
                    }
                );

                const deleteForms =
                    document.querySelectorAll(
                        ".delete-widget-form"
                    );

                deleteForms.forEach(
                    function (form) {

                        form.addEventListener(
                            "submit",
                            function (event) {

                                const confirmed =
                                    window.confirm(
                                        "Are you sure you want to delete " +
                                        "this dashboard widget?"
                                    );

                                if (!confirmed) {
                                    event.preventDefault();
                                }
                            }
                        );
                    }
                );

                const designerList =
                    document.getElementById(
                        "dashboardDesignerList"
                    );

                const saveButton =
                    document.getElementById(
                        "saveLayoutBtn"
                    );

                const messageBox =
                    document.getElementById(
                        "saveMessage"
                    );

                if (!saveButton) {
                    return;
                }

                saveButton.disabled = true;

                /*
                 * Do not initialise SortableJS unless the complete,
                 * unfiltered dashboard layout is displayed in its
                 * normal display order.
                 */
                if (!canEditLayout ||
                    !designerList ||
                    !messageBox) {

                    return;
                }

                new Sortable(
                    designerList,
                    {
                        animation: 150,

                        handle:
                            ".drag-handle",

                        ghostClass:
                            "sortable-ghost",

                        chosenClass:
                            "sortable-chosen",

                        dragClass:
                            "shadow-lg",

                        onEnd: function () {

                            saveButton.disabled =
                                false;

                            messageBox.innerText =
                                "Layout has unsaved changes.";

                            messageBox.classList.remove(
                                "d-none",
                                "alert-success",
                                "alert-danger"
                            );

                            messageBox.classList.add(
                                "alert-warning"
                            );
                        }
                    }
                );

                saveButton.addEventListener(
                    "click",
                    function () {

                        const widgets =
                            document.querySelectorAll(
                                ".dashboard-widget-item"
                            );

                        const layoutItems = [];

                        widgets.forEach(
                            function (item, index) {

                                layoutItems.push({
                                    widgetId:
                                        item.getAttribute(
                                            "data-widget-id"
                                        ),

                                    rowPosition:
                                        1,

                                    columnPosition:
                                        index + 1,

                                    widgetWidth:
                                        parseInt(
                                            item.getAttribute(
                                                "data-widget-width"
                                            )
                                        ) || 4,

                                    height:
                                        parseInt(
                                            item.getAttribute(
                                                "data-height"
                                            )
                                        ) || 300,

                                    displayOrder:
                                        index + 1
                                });
                            }
                        );

                        const tokenInput =
                            document.querySelector(
                                'input[name="' +
                                '__RequestVerificationToken' +
                                '"]'
                            );

                        if (!tokenInput) {

                            alert(
                                "The anti-forgery token " +
                                "was not found."
                            );

                            return;
                        }

                        saveButton.disabled =
                            true;

                        fetch(
                            "/DashboardDesigner/SaveLayout",
                            {
                                method:
                                    "POST",

                                headers: {
                                    "Content-Type":
                                        "application/json",

                                    "RequestVerificationToken":
                                        tokenInput.value
                                },

                                body:
                                    JSON.stringify(
                                        layoutItems
                                    )
                            }
                        )
                        .then(
                            async function (response) {

                                if (!response.ok) {

                                    const errorText =
                                        await response.text();

                                    throw new Error(
                                        errorText ||
                                        "Save layout failed."
                                    );
                                }

                                return response.json();
                            }
                        )
                        .then(
                            function (data) {

                                messageBox.innerText =
                                    data.message;

                                messageBox.classList.remove(
                                    "d-none",
                                    "alert-warning",
                                    "alert-danger"
                                );

                                messageBox.classList.add(
                                    "alert-success"
                                );

                                saveButton.disabled =
                                    true;

                                setTimeout(
                                    function () {

                                        window.location.reload();
                                    },
                                    800
                                );
                            }
                        )
                        .catch(
                            function (error) {

                                messageBox.innerText =
                                    error.message;

                                messageBox.classList.remove(
                                    "d-none",
                                    "alert-success",
                                    "alert-warning"
                                );

                                messageBox.classList.add(
                                    "alert-danger"
                                );

                                saveButton.disabled =
                                    false;
                            }
                        );
                    }
                );
            }
        );
    </script>
}
