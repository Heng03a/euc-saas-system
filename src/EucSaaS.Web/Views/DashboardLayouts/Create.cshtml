@model EucSaaS.Web.ViewModels.DashboardLayouts.DashboardLayoutEditViewModel

@{
    ViewData["Title"] = "Create Dashboard Layout";
}

<div class="container-fluid py-3">

    <!-- ============================================================
         Page Header
         ============================================================ -->
    <div class="d-flex
                flex-column
                flex-md-row
                justify-content-between
                align-items-md-center
                gap-3
                mb-4">

        <div>
            <h1 class="h3 mb-1">
                <i class="bi bi-layout-text-window-reverse me-2"></i>
                Create Dashboard Layout
            </h1>

            <p class="text-muted mb-0">
                Create a dashboard layout and configure its
                role, department, sharing, and default settings.
            </p>
        </div>

        <div>
            <a asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>
                Back to Layouts

            </a>
        </div>

    </div>

    <!-- ============================================================
         Validation Summary
         ============================================================ -->
    <div asp-validation-summary="ModelOnly"
         class="alert alert-danger"
         role="alert">
    </div>

    <!-- ============================================================
         Create Form
         ============================================================ -->
    <form asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div class="row g-4">

            <!-- ====================================================
                 Main Layout Information
                 ==================================================== -->
            <div class="col-12 col-xl-8">

                <div class="card shadow-sm">

                    <div class="card-header bg-body-tertiary">
                        <div class="fw-semibold">
                            <i class="bi bi-info-circle me-2"></i>
                            Layout Information
                        </div>
                    </div>

                    <div class="card-body">

                        <div class="row g-3">

                            <!-- Layout Code -->
                            <div class="col-12 col-md-6">

                                <label asp-for="LayoutCode"
                                       class="form-label">
                                </label>

                                <input asp-for="LayoutCode"
                                       class="form-control"
                                       maxlength="100"
                                       autocomplete="off"
                                       placeholder="e.g. MANAGER_DASHBOARD" />

                                <span asp-validation-for="LayoutCode"
                                      class="text-danger small">
                                </span>

                                <div class="form-text">
                                    Use letters, numbers, and underscores only.
                                </div>

                            </div>

                            <!-- Layout Name -->
                            <div class="col-12 col-md-6">

                                <label asp-for="LayoutName"
                                       class="form-label">
                                </label>

                                <input asp-for="LayoutName"
                                       class="form-control"
                                       maxlength="200"
                                       autocomplete="off"
                                       placeholder="e.g. Manager Dashboard" />

                                <span asp-validation-for="LayoutName"
                                      class="text-danger small">
                                </span>

                            </div>

                            <!-- Description -->
                            <div class="col-12">

                                <label asp-for="Description"
                                       class="form-label">
                                </label>

                                <textarea asp-for="Description"
                                          class="form-control"
                                          rows="4"
                                          maxlength="1000"
                                          placeholder="Optional description of this dashboard layout.">
                                </textarea>

                                <span asp-validation-for="Description"
                                      class="text-danger small">
                                </span>

                                <div class="form-text">
                                    Maximum 1,000 characters.
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

                <!-- ====================================================
                     Access Scope
                     ==================================================== -->
                <div class="card shadow-sm mt-4">

                    <div class="card-header bg-body-tertiary">
                        <div class="fw-semibold">
                            <i class="bi bi-people me-2"></i>
                            Access Scope
                        </div>
                    </div>

                    <div class="card-body">

                        <div class="row g-3">

                            <!-- Role -->
                            <div class="col-12 col-md-6">

                                <label asp-for="AppRoleId"
                                       class="form-label">
                                </label>

                                <select asp-for="AppRoleId"
                                        asp-items="Model.RoleOptions"
                                        class="form-select">

                                    <option value="">
                                        All roles
                                    </option>

                                </select>

                                <span asp-validation-for="AppRoleId"
                                      class="text-danger small">
                                </span>

                                <div class="form-text">
                                    Leave blank if the layout is not restricted
                                    to a specific role.
                                </div>

                            </div>

                            <!-- Department -->
                            <div class="col-12 col-md-6">

                                <label asp-for="DepartmentId"
                                       class="form-label">
                                </label>

                                <select asp-for="DepartmentId"
                                        asp-items="Model.DepartmentOptions"
                                        class="form-select">

                                    <option value="">
                                        All departments
                                    </option>

                                </select>

                                <span asp-validation-for="DepartmentId"
                                      class="text-danger small">
                                </span>

                                <div class="form-text">
                                    Leave blank if the layout applies to
                                    all departments.
                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- ====================================================
                 Settings
                 ==================================================== -->
            <div class="col-12 col-xl-4">

                <div class="card shadow-sm">

                    <div class="card-header bg-body-tertiary">

                        <div class="fw-semibold">
                            <i class="bi bi-sliders me-2"></i>
                            Layout Settings
                        </div>

                    </div>

                    <div class="card-body">

                        <!-- Active -->
                        <div class="form-check form-switch mb-4">

                            <input asp-for="IsActive"
                                   class="form-check-input"
                                   type="checkbox"
                                   role="switch" />

                            <label asp-for="IsActive"
                                   class="form-check-label fw-semibold">
                            </label>

                            <div class="form-text">
                                Active layouts are available for use.
                            </div>

                        </div>

                        <hr />

                        <!-- Shared -->
                        <div class="form-check form-switch my-4">

                            <input asp-for="IsShared"
                                   class="form-check-input"
                                   type="checkbox"
                                   role="switch" />

                            <label asp-for="IsShared"
                                   class="form-check-label fw-semibold">
                            </label>

                            <div class="form-text">
                                Shared layouts may be available to other
                                eligible users in the tenant.
                            </div>

                        </div>

                        <hr />

                        <!-- Default -->
                        <div class="form-check form-switch mt-4">

                            <input asp-for="IsDefault"
                                   class="form-check-input"
                                   type="checkbox"
                                   role="switch" />

                            <label asp-for="IsDefault"
                                   class="form-check-label fw-semibold">
                            </label>

                            <div class="form-text">
                                Make this the default dashboard layout
                                for its applicable scope.
                            </div>

                            <span asp-validation-for="IsDefault"
                                  class="text-danger small d-block mt-1">
                            </span>

                        </div>

                    </div>

                </div>

                <!-- ====================================================
                     Information
                     ==================================================== -->
                <div class="card shadow-sm mt-4">

                    <div class="card-header bg-body-tertiary">

                        <div class="fw-semibold">
                            <i class="bi bi-lightbulb me-2"></i>
                            Notes
                        </div>

                    </div>

                    <div class="card-body">

                        <ul class="small text-muted mb-0 ps-3">

                            <li class="mb-2">
                                Layout Code must be unique within the tenant.
                            </li>

                            <li class="mb-2">
                                Layout Code can contain only letters,
                                numbers, and underscores.
                            </li>

                            <li class="mb-2">
                                A default layout must also be active.
                            </li>

                            <li>
                                Role and Department are optional.
                            </li>

                        </ul>

                    </div>

                </div>

            </div>

        </div>

        <!-- ============================================================
             Actions
             ============================================================ -->
        <div class="d-flex
                    flex-column
                    flex-sm-row
                    justify-content-end
                    gap-2
                    mt-4">

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-x-circle me-1"></i>
                Cancel

            </a>

            <button type="submit"
                    class="btn btn-primary">

                <i class="bi bi-check-circle me-1"></i>
                Save Layout

            </button>

        </div>

    </form>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        (() => {

            const layoutCode =
                document.getElementById("LayoutCode");

            const activeCheckbox =
                document.getElementById("IsActive");

            const defaultCheckbox =
                document.getElementById("IsDefault");

            // --------------------------------------------------------
            // Normalize Layout Code
            // --------------------------------------------------------
            if (layoutCode) {

                layoutCode.addEventListener(
                    "input",
                    function () {

                        this.value =
                            this.value
                                .toUpperCase()
                                .replace(/\s+/g, "_");

                    });

            }

            // --------------------------------------------------------
            // Default layout must remain active
            // --------------------------------------------------------
            if (activeCheckbox &&
                defaultCheckbox) {

                defaultCheckbox.addEventListener(
                    "change",
                    function () {

                        if (this.checked) {

                            activeCheckbox.checked =
                                true;

                        }

                    });

                activeCheckbox.addEventListener(
                    "change",
                    function () {

                        if (!this.checked &&
                            defaultCheckbox.checked) {

                            defaultCheckbox.checked =
                                false;

                        }

                    });

            }

        })();
    </script>
}
