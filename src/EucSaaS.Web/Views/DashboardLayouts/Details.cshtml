@model EucSaaS.Web.ViewModels.DashboardLayouts.DashboardLayoutDetailsViewModel

@{
    ViewData["Title"] = "Dashboard Layout Details";
}

<div class="container-fluid py-3">

    <!-- ============================================================
         Header
         ============================================================ -->
    <div class="d-flex
                flex-column
                flex-md-row
                justify-content-between
                align-items-md-center
                gap-3
                mb-4">

        <div>

            <h1 class="h3 mb-1">

                <i class="bi bi-layout-text-window-reverse me-2"></i>

                Dashboard Layout Details

            </h1>

            <p class="text-muted mb-0">

                Review the layout configuration, ownership,
                scope, and dashboard items.

            </p>

        </div>

        <div class="d-flex flex-wrap gap-2">

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                <i class="bi bi-arrow-left me-1"></i>

                Back to Layouts

            </a>

            @if (!Model.IsSystem)
            {
                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary">

                    <i class="bi bi-pencil-square me-1"></i>

                    Edit

                </a>
            }

        </div>

    </div>

    <!-- ============================================================
         TempData Messages
         ============================================================ -->
    @if (TempData["SuccessMessage"] is string successMessage)
    {
        <div class="alert
                    alert-success
                    alert-dismissible
                    fade
                    show"
             role="alert">

            <i class="bi bi-check-circle me-2"></i>

            @successMessage

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }

    @if (TempData["ErrorMessage"] is string errorMessage)
    {
        <div class="alert
                    alert-danger
                    alert-dismissible
                    fade
                    show"
             role="alert">

            <i class="bi bi-exclamation-triangle me-2"></i>

            @errorMessage

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"
                    aria-label="Close">
            </button>

        </div>
    }

    <div class="row g-4">

        <!-- ========================================================
             Main Details
             ======================================================== -->
        <div class="col-12 col-xl-8">

            <!-- ====================================================
                 Layout Information
                 ==================================================== -->
            <div class="card shadow-sm">

                <div class="card-header bg-body-tertiary">

                    <div class="fw-semibold">

                        <i class="bi bi-info-circle me-2"></i>

                        Layout Information

                    </div>

                </div>

                <div class="card-body">

                    <div class="row g-4">

                        <!-- Layout Code -->
                        <div class="col-12 col-md-6">

                            <div class="text-muted small">

                                Layout Code

                            </div>

                            <div class="fw-semibold mt-1">

                                @Model.LayoutCode

                            </div>

                        </div>

                        <!-- Layout Name -->
                        <div class="col-12 col-md-6">

                            <div class="text-muted small">

                                Layout Name

                            </div>

                            <div class="fw-semibold mt-1">

                                @Model.LayoutName

                            </div>

                        </div>

                        <!-- Description -->
                        <div class="col-12">

                            <div class="text-muted small">

                                Description

                            </div>

                            <div class="mt-1">

                                @if (string.IsNullOrWhiteSpace(
                                    Model.Description))
                                {
                                    <span class="text-muted">

                                        No description provided.

                                    </span>
                                }
                                else
                                {
                                    @Model.Description
                                }

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- ====================================================
                 Access Scope
                 ==================================================== -->
            <div class="card shadow-sm mt-4">

                <div class="card-header bg-body-tertiary">

                    <div class="fw-semibold">

                        <i class="bi bi-people me-2"></i>

                        Access Scope

                    </div>

                </div>

                <div class="card-body">

                    <div class="row g-4">

                        <!-- Role -->
                        <div class="col-12 col-md-6">

                            <div class="text-muted small">

                                Role

                            </div>

                            <div class="mt-1">

                                @if (string.IsNullOrWhiteSpace(
                                    Model.RoleName))
                                {
                                    <span class="badge bg-secondary">

                                        <i class="bi bi-people me-1"></i>

                                        All Roles

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">

                                        <i class="bi bi-person-badge me-1"></i>

                                        @Model.RoleName

                                    </span>
                                }

                            </div>

                        </div>

                        <!-- Department -->
                        <div class="col-12 col-md-6">

                            <div class="text-muted small">

                                Department

                            </div>

                            <div class="mt-1">

                                @if (string.IsNullOrWhiteSpace(
                                    Model.DepartmentName))
                                {
                                    <span class="badge bg-secondary">

                                        <i class="bi bi-building me-1"></i>

                                        All Departments

                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-info text-dark">

                                        <i class="bi bi-building me-1"></i>

                                        @Model.DepartmentName

                                    </span>
                                }

                            </div>

                        </div>

                    </div>

                </div>

            </div>

            <!-- ====================================================
                 Dashboard Items
                 ==================================================== -->
            <div class="card shadow-sm mt-4">

                <div class="card-header
                            bg-body-tertiary
                            d-flex
                            justify-content-between
                            align-items-center">

                    <div class="fw-semibold">

                        <i class="bi bi-grid-3x3-gap me-2"></i>

                        Dashboard Items

                    </div>

                    <span class="badge bg-secondary">

                        @Model.Items.Count

                    </span>

                </div>

                <div class="card-body p-0">

                    @if (Model.Items == null ||
                         Model.Items.Count == 0)
                    {
                        <div class="p-4
                                    text-center
                                    text-muted">

                            <i class="bi
                                      bi-grid-3x3-gap
                                      fs-2
                                      d-block
                                      mb-2">
                            </i>

                            No dashboard items have been assigned
                            to this layout.

                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">

                            <table class="table
                                          table-hover
                                          align-middle
                                          mb-0">

                                <thead class="table-light">

                                    <tr>

                                        <th>
                                            Widget
                                        </th>

                                        <th>
                                            Type
                                        </th>

                                        <th>
                                            Position
                                        </th>

                                        <th>
                                            Size
                                        </th>

                                        <th>
                                            Order
                                        </th>

                                        <th>
                                            Status
                                        </th>

                                    </tr>

                                </thead>

                                <tbody>

                                    @foreach (var item in Model.Items)
                                    {
                                        <tr>

                                            <!-- Widget -->
                                            <td>

                                                <div class="fw-semibold">

                                                    @item.WidgetName

                                                </div>

                                                <div class="small text-muted">

                                                    @item.WidgetCode

                                                </div>

                                            </td>

                                            <!-- Widget Type -->
                                            <td>

                                                @if (string.IsNullOrWhiteSpace(
                                                    item.WidgetType))
                                                {
                                                    <span class="text-muted">

                                                        —

                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light
                                                                         text-dark
                                                                         border">

                                                        @item.WidgetType

                                                    </span>
                                                }

                                            </td>

                                            <!-- Position -->
                                            <td>

                                                Row @item.GridRow,
                                                Column @item.GridColumn

                                            </td>

                                            <!-- Size -->
                                            <td>

                                                @item.GridWidth ×
                                                @item.GridHeight

                                            </td>

                                            <!-- Display Order -->
                                            <td>

                                                @item.DisplayOrder

                                            </td>

                                            <!-- Visibility -->
                                            <td>

                                                @if (item.IsVisible)
                                                {
                                                    <span class="badge bg-success">

                                                        <i class="bi
                                                                  bi-eye
                                                                  me-1">
                                                        </i>

                                                        Visible

                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">

                                                        <i class="bi
                                                                  bi-eye-slash
                                                                  me-1">
                                                        </i>

                                                        Hidden

                                                    </span>
                                                }

                                            </td>

                                        </tr>
                                    }

                                </tbody>

                            </table>

                        </div>
                    }

                </div>

            </div>

        </div>

        <!-- ========================================================
             Settings / Status
             ======================================================== -->
        <div class="col-12 col-xl-4">

            <!-- ====================================================
                 Layout Settings
                 ==================================================== -->
            <div class="card shadow-sm">

                <div class="card-header bg-body-tertiary">

                    <div class="fw-semibold">

                        <i class="bi bi-sliders me-2"></i>

                        Layout Settings

                    </div>

                </div>

                <div class="card-body">

                    <!-- Ownership -->
                    <div class="mb-4">

                        <div class="text-muted small mb-1">

                            Ownership

                        </div>

                        @if (Model.IsSystem)
                        {
                            <span class="badge bg-dark">

                                <i class="bi
                                          bi-shield-lock
                                          me-1">
                                </i>

                                System Layout

                            </span>
                        }
                        else
                        {
                            <span class="badge bg-primary">

                                <i class="bi
                                          bi-building
                                          me-1">
                                </i>

                                Tenant Layout

                            </span>
                        }

                    </div>

                    <hr />

                    <!-- Active -->
                    <div class="d-flex
                                justify-content-between
                                align-items-center
                                py-2">

                        <span>

                            Active

                        </span>

                        @if (Model.IsActive)
                        {
                            <span class="badge bg-success">

                                <i class="bi
                                          bi-check-circle
                                          me-1">
                                </i>

                                Active

                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">

                                <i class="bi
                                          bi-pause-circle
                                          me-1">
                                </i>

                                Inactive

                            </span>
                        }

                    </div>

                    <!-- Shared -->
                    <div class="d-flex
                                justify-content-between
                                align-items-center
                                py-2">

                        <span>

                            Shared

                        </span>

                        @if (Model.IsShared)
                        {
                            <span class="badge bg-info text-dark">

                                <i class="bi
                                          bi-people
                                          me-1">
                                </i>

                                Shared

                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">

                                <i class="bi
                                          bi-person
                                          me-1">
                                </i>

                                Private

                            </span>
                        }

                    </div>

                    <!-- Default -->
                    <div class="d-flex
                                justify-content-between
                                align-items-center
                                py-2">

                        <span>

                            Default

                        </span>

                        @if (Model.IsDefault)
                        {
                            <span class="badge
                                         bg-warning
                                         text-dark">

                                <i class="bi
                                          bi-star-fill
                                          me-1">
                                </i>

                                Default

                            </span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">

                                <i class="bi
                                          bi-star
                                          me-1">
                                </i>

                                No

                            </span>
                        }

                    </div>

                </div>

            </div>

            <!-- ====================================================
                 Audit Information
                 ==================================================== -->
            <div class="card shadow-sm mt-4">

                <div class="card-header bg-body-tertiary">

                    <div class="fw-semibold">

                        <i class="bi bi-clock-history me-2"></i>

                        Audit Information

                    </div>

                </div>

                <div class="card-body">

                    <!-- Created -->
                    <div class="mb-3">

                        <div class="text-muted small">

                            Created

                        </div>

                        <div class="mt-1">

                            @Model.CreatedAt.ToString(
                                "dd MMM yyyy HH:mm")

                        </div>

                    </div>

                    <!-- Created By -->
                    <div class="mb-3">

                        <div class="text-muted small">

                            Created By

                        </div>

                        <div class="mt-1">

                            @Model.CreatedBy

                        </div>

                    </div>

                    <!-- Last Updated -->
                    <div class="mb-3">

                        <div class="text-muted small">

                            Last Updated

                        </div>

                        <div class="mt-1">

                            @if (Model.UpdatedAt.HasValue)
                            {
                                @Model.UpdatedAt.Value.ToString(
                                    "dd MMM yyyy HH:mm")
                            }
                            else
                            {
                                <span class="text-muted">

                                    Never

                                </span>
                            }

                        </div>

                    </div>

                    <!-- Updated By -->
                    <div>

                        <div class="text-muted small">

                            Updated By

                        </div>

                        <div class="mt-1">

                            @if (string.IsNullOrWhiteSpace(
                                Model.UpdatedBy))
                            {
                                <span class="text-muted">

                                    —

                                </span>
                            }
                            else
                            {
                                @Model.UpdatedBy
                            }

                        </div>

                    </div>

                </div>

            </div>

            <!-- ====================================================
                 Actions
                 ==================================================== -->
            @if (!Model.IsSystem)
            {
                <div class="card shadow-sm mt-4">

                    <div class="card-header bg-body-tertiary">

                        <div class="fw-semibold">

                            <i class="bi bi-lightning me-2"></i>

                            Actions

                        </div>

                    </div>

                    <div class="card-body">

                        <div class="d-grid gap-2">

                            <!-- Edit -->
                            <a asp-action="Edit"
                               asp-route-id="@Model.Id"
                               class="btn btn-outline-primary">

                                <i class="bi
                                          bi-pencil-square
                                          me-1">
                                </i>

                                Edit Layout

                            </a>

                            <!-- Set Default -->
                            @if (!Model.IsDefault)
                            {
                                <form asp-action="SetDefault"
                                      asp-route-id="@Model.Id"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn
                                                   btn-outline-warning
                                                   w-100">

                                        <i class="bi
                                                  bi-star
                                                  me-1">
                                        </i>

                                        Set as Default

                                    </button>

                                </form>
                            }

                            <!-- Activate / Deactivate -->
                            @if (Model.IsActive)
                            {
                                <form asp-action="Deactivate"
                                      asp-route-id="@Model.Id"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn
                                                   btn-outline-secondary
                                                   w-100">

                                        <i class="bi
                                                  bi-pause-circle
                                                  me-1">
                                        </i>

                                        Deactivate

                                    </button>

                                </form>
                            }
                            else
                            {
                                <form asp-action="Activate"
                                      asp-route-id="@Model.Id"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn
                                                   btn-outline-success
                                                   w-100">

                                        <i class="bi
                                                  bi-play-circle
                                                  me-1">
                                        </i>

                                        Activate

                                    </button>

                                </form>
                            }

                            <!-- Delete -->
                            <a asp-action="Delete"
                               asp-route-id="@Model.Id"
                               class="btn btn-outline-danger">

                                <i class="bi
                                          bi-trash
                                          me-1">
                                </i>

                                Delete

                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>

    </div>

</div>
