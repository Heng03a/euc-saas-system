@model EucSaaS.Web.ViewModels.DashboardWidgetTemplates.DashboardWidgetTemplateFormViewModel

@{
    ViewData["Title"] = "Create Dashboard Widget Template";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="h3 mb-1">
                Create Dashboard Widget Template
            </h1>

            <p class="text-muted mb-0">
                Create a reusable tenant-specific dashboard widget template.
            </p>
        </div>

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Templates
        </a>

    </div>

    <div class="card shadow-sm">

        <div class="card-header bg-white">

            <h2 class="h5 mb-0">
                Template Information
            </h2>

        </div>

        <div class="card-body">

            <form asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()

                <partial name="_Form"
                         model="Model" />

                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        <i class="bi bi-plus-circle me-1"></i>
                        Create Template
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const templateCode =
                document.getElementById("TemplateCode");

            if (templateCode) {
                templateCode.addEventListener("input", function () {

                    this.value = this.value
                        .toUpperCase()
                        .replace(/[^A-Z0-9_]/g, "_");
                });
            }

        });
    </script>
}
